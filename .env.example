# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project Settings -> Environment Variables.

# Required for the AI Assistant widget (/api/chat). Get one at platform.openai.com.
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini.
OPENAI_MODEL=

# Required for the Contact form (/api/contact). Get one at resend.com.
RESEND_API_KEY=
# Optional — where contact form submissions are delivered. Defaults to the email in src/data/site.ts.
CONTACT_TO_EMAIL=
